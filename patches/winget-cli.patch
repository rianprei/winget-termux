-            Column(QCol(ManifestTable::TableName(), IdTable::ValueName())).
-            Column(QCol(tempTableAlias, s_SearchResultsTable_MatchField)).
-            Column(QCol(tempTableAlias, s_SearchResultsTable_MatchType)).
